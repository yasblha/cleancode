{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@app/*": ["src/*"],
      "@application/*": ["/app/application/*"],
      "@domain/*": ["/app/domain/*"],
      "@infrastructure/*": ["/app/infrastructure/*"]
    },
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts",
    "/app/application/**/*.ts",
    "/app/domain/**/*.ts",
    "/app/infrastructure/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}