{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDirs": [
      "./src",
      "../../../../application",
      "../../../../domain",
      "../../../../infrastructure"
    ],
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@app/*": ["src/*"],
      "@application/*": ["../../../../application/*"],
      "@domain/*": ["../../../../domain/*"],
      "@infrastructure/*": ["../../../../infrastructure/*"]
    },
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}